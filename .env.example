# Manthan - top-level environment checklist.
#
# Each service loads its OWN env file (`manthan-api/.env` for the API +
# agents + workers, `agent/.env` for running the agent harness directly) -
# nothing reads this root file at runtime. It exists as the master
# checklist of every variable the stack uses, and as a convenient
# KEY=value input for `deploy/gcp/secrets-bootstrap.sh` (which pushes
# known vars into Secret Manager with per-secret IAM).
#
# Copy to .env and fill in real values. Never commit .env.

# ── LLM (Gemini via Google AI Studio) ──────────────────────────────────
# All models are Gemini through AI Studio - get a key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model tiers (defaults shown; see agent/src/manthan_agent/config.py)
# MANTHAN_MODEL=gemini-3.1-pro-preview        # investigator coordinator
# MANTHAN_MODEL_SUBAGENT=gemini-3.5-flash     # specialists + advisor
# MANTHAN_MODEL_TRIAGE=gemini-3.1-flash-lite  # triage + prettifier

# ── Coral (the grounding/data plane) ───────────────────────────────────
# Path to the Coral binary the investigator spawns via `coral mcp-stdio`.
# Defaults to `coral` on PATH.
CORAL_BINARY=coral

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://manthan:manthan_dev@localhost:5433/manthan

# ── Auth (Clerk) ───────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_VERIFICATION_KEY=
CLERK_WEBHOOK_SECRET=

# ── Trigger (Stripe webhook → triage agent) ────────────────────────────
STRIPE_WEBHOOK_SECRET=

# ── Actor action credentials (post-approval writes) ────────────────────
STRIPE_API_KEY=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
SLACK_TOKEN=
NOTION_API_KEY=
NOTION_DECISION_LOG_PARENT_ID=
LINEAR_API_KEY=

# ── Source query credentials (read-only, registered with Coral) ────────
HUBSPOT_ACCESS_TOKEN=
INTERCOM_ACCESS_TOKEN=
POSTHOG_API_BASE=https://us.posthog.com
POSTHOG_API_KEY=
SENTRY_ORG=
SENTRY_TOKEN=
DD_SITE=datadoghq.com
DD_API_KEY=
DD_APPLICATION_KEY=
PAGERDUTY_API_TOKEN=
# Optional CRM source (not in the default GCP bootstrap set):
# SALESFORCE_INSTANCE_URL=
# SALESFORCE_ACCESS_TOKEN=

# ── Integrity keys ─────────────────────────────────────────────────────
EVENT_SIGNING_KEY=change-me-to-a-32-byte-hex
SOURCE_CONFIG_KEY=change-me-to-a-32-byte-hex

# ── Frontend ───────────────────────────────────────────────────────────
WEB_APP_ORIGIN=http://localhost:5173

# Root build context - keep this MINIMAL. NOTE: the GCP builds use the
# per-image deploy/gcp/Dockerfile.{api,ui}.dockerignore files instead
# (deploy.sh swaps them in); this root file exists to keep any ad-hoc
# `gcloud builds submit` / `docker build` context small.

# Always-junk
.git
.DS_Store
*.log
.env
.env.local

# Python build artifacts
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache

# Node
**/node_modules
manthan-ui/dist

# Don't ship the UI source into the API container
manthan-ui

# Agent's local scratch
agent/.manthan
agent/scripts/__pycache__
agent/.venv

# Manthan agent - local config.
# Copy to .env and fill in. .env is gitignored.
#
# Runtime split:
#   * The AGENT process only needs the LLM + Coral vars below. It does
#     NOT hold per-source credentials at runtime - those live on the
#     Coral side; Coral authenticates against every connected source
#     and the agent just asks it for data over MCP stdio.
#   * The SOURCE CREDENTIALS section is read by the seed_*.py /
#     patch_*.py scripts in scripts/, which write the demo fixtures
#     into the real SaaS accounts directly (not through Coral).
#
# If you're wiring up Coral itself, see the Coral repo for its own
# `coral source add <kind> --token=...` flow.


# ── LLM (Gemini via AI Studio) ────────────────────────────────────────
# Required. AI Studio API key - get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Keep FALSE: authenticate against AI Studio
# (generativelanguage.googleapis.com), not Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model tiers (all optional - these are the defaults).
# Investigator coordinator:
MANTHAN_MODEL=gemini-3.1-pro-preview
# Parallel specialists + advisor:
MANTHAN_MODEL_SUBAGENT=gemini-3.5-flash
# Triage router + event prettifier:
MANTHAN_MODEL_TRIAGE=gemini-3.1-flash-lite


# ── Coral ─────────────────────────────────────────────────────────────
# Path to the Coral binary the agent will spawn over MCP stdio.
# Defaults to `coral` (assumes it's on PATH). Override if you built
# from source and want to point at a specific build.
CORAL_BINARY=coral


# ── Source credentials (seed scripts only) ────────────────────────────
# Optional. Read by scripts/seed_*.py + scripts/patch_*.py to populate
# the demo SaaS accounts. Leave blank for any source you aren't
# seeding. The full list (Chargebee, Salesforce, Zendesk, Gmail,
# Twilio, ...) lives in src/manthan_agent/config.py.
STRIPE_API_KEY=
HUBSPOT_ACCESS_TOKEN=
INTERCOM_ACCESS_TOKEN=
SLACK_BOT_TOKEN=
NOTION_API_KEY=
PAGERDUTY_API_TOKEN=
DD_SITE=datadoghq.com
DD_API_KEY=
DD_APPLICATION_KEY=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.posthog.com
